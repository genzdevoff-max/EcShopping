# Copy this file to `.env` and fill in real values, then restart the server.
# NEVER commit the real `.env` (it is git-ignored). Rotate any value that ever
# appears in a commit history or log output.

# ---- Database (TiDB Cloud) — required. The server refuses to start without these. ----
DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=<cluster-user>
DB_PASSWORD=<db-password>
DB_NAME=ecshopping

# ---- JWT auth signing — required. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<64-128-char random hex>

# ---- First admin account ----
# Bootstrap the admin with:  npm run db:create-admin
# (requires ADMIN_EMAIL + a strong ADMIN_PASSWORD, 12+ characters).
# The legacy VITE_ADMIN_EMAIL / VITE_ADMIN_PASSWORD client variables are no
# longer used — admin credentials live only in the `admins` table.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>

# ---- Gmail SMTP — use a Google App Password, not your normal account password. ----
# How to get a Google App Password:
# 1. Enable 2-Step Verification in Google Account -> Security.
# 2. Search for "App Passwords", generate one for "Mail" / "EcShopping".
# 3. Paste the 16-character code into SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SENDER_NAME=EcShopping

# ---- Cloudinary (product image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- PhonePe Gateway: Dual-Mode Architecture Support ----
# EcShopping supports both PhonePe integration options:
#
# OPTION B: Standard Checkout v2 (Current Active Implementation)
# Credentials come from PhonePe Business Dashboard -> Developer Settings -> API Keys.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_SECRET=
# PhonePe Customer Browser Return URL (canonical production storefront):
# In production on Vercel: https://ecshopping.in/payment/phonepe/return
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/phonepe/return
# PhonePe Server-to-Server Callback/Webhook URL:
PHONEPE_CALLBACK_URL=https://ec-shopping-three.vercel.app/api/payments/phonepe/callback
#
# OPTION A: Legacy Custom Merchant ID + Salt Key / Salt Index (Design Reference)
# For merchants with Hermes PG v1 credentials:
# PHONEPE_MODE=v2 # or 'v1'
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1

# ---- Frontend Canonical Storefront Origin (for email password-reset links and PhonePe return routing) ----
# In production on Vercel set: FRONTEND_URL=https://ecshopping.in
FRONTEND_URL=http://localhost:5173

# ---- Auth rate limiting (optional overrides) ----
# LOGIN attempts allowed per IP per window (default 10 / 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Registrations per IP per hour (default 5)
RATE_LIMIT_REGISTER_MAX=5
# Review submissions per IP per hour (default 20)
RATE_LIMIT_REVIEW_MAX=20

# Optional
PORT=5000
